ress__PercentWrapper"] { border: 1px solid rgb(255, 0, 0); border-radius: 4=
px; }
  &.fk-option-grid--2 .option-button__selected.correct div[class*=3D"progre=
ss__PercentWrapper"] { border-width: medium; border-style: none; border-col=
or: currentcolor; border-image: initial; border-radius: 4px; }
  & .option-button.correct::after { border-width: medium; border-style: non=
e; border-color: currentcolor; border-image: initial; }
}

